NODE_ENV=development
PORT=3000

# Generate a value with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-characters-long

# Frontend origins allowed to call the API in production (comma-separated)
ALLOWED_ORIGINS=https://www.example.com

# Stripe keys
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: if you later deploy on a frontend platform, keep these values explicit
# CLOUDFLARE_PAGES_DOMAIN=https://your-site.pages.dev
